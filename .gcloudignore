.env
.env.*

# Local SQLite budget & cache artifacts
.data/
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db

# Tests, coverage & logs
tests/
coverage/
logs/
*.log
npm-debug.log*
