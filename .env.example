# Foreal-Estate Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or actual secret values.
# On Cloud Run, bind server secrets via Google Cloud Secret Manager.

# Runtime HTTP server configuration (binds 0.0.0.0)
NODE_ENV=development
PORT=8080

# RentCast Property & AVM API (Server-only secret — NEVER expose to browser)
RENTCAST_API_KEY=
# Hard monthly account call ceiling strictly below RentCast's 50-call free tier
RENTCAST_GLOBAL_MONTHLY_LIMIT=35
# Calls already consumed on the RentCast account in the current billing cycle prior to startup
RENTCAST_INITIAL_SPENT_CALLS=0

# Durable Budget Store ("sqlite" for local single-host dev, "firestore" for multi-instance Cloud Run)
BUDGET_STORE_MODE=sqlite
SQLITE_BUDGET_PATH=.data/rentcast-budget.sqlite
GOOGLE_CLOUD_PROJECT=
FIRESTORE_BUDGET_COLLECTION=rentcast_budget

# Grounded Gemini Explanation API (Server-only secret — NEVER expose to browser)
GEMINI_API_KEY=
# Set GOOGLE_GENAI_USE_VERTEXAI=true when using a service-account-bound Vertex AI API key (projects/<id>/locations/global/publishers/google/models/...)
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_EXPLAIN_MODEL=gemini-4-hydrogen
GEMINI_EXPLAIN_FALLBACK_MODEL=gemini-2.5-flash

# Google Maps Basemap & Optional Display-Only Context
# HTTP-referrer-restricted browser key intentionally served via GET /api/config for Maps JS SDK
GOOGLE_MAPS_BROWSER_KEY=
# Optional server-only Places key for attributed display-only context (google_places_context; barred from scoring)
GOOGLE_PLACES_SERVER_KEY=

# Licensed Public Geospatial Endpoints
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Opt-in explicitly badged synthetic demo fixtures when live provider keys are absent ("true" or "false")
ENABLE_SYNTHETIC_DEMO_MODE=false
